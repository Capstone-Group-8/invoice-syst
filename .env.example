# Default development database (no MySQL/XAMPP required)
DATABASE_URL=sqlite:///./capstone_group_8.db

# React development origins allowed by FastAPI
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# To use the team's MySQL database instead, set something like:
# DATABASE_URL=mysql+mysqlconnector://USERNAME:PASSWORD@localhost/capstone_group_8
